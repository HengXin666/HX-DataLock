{
  "name": "@hx/datalock",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "HX-DataLock codec for Node and browsers. v1 envelopes stay compatible; streaming uses hxdl.stream.v1.",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "hx-datalock.mjs",
    "README.md"
  ],
  "bin": {
    "hxdl-node": "./hx-datalock.mjs"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "node": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.browser.mjs",
    "test:compat": "uv run pytest tests/compat/test_cross_language.py -q"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1"
  }
}
